{
  "name": "testready-editor",
  "version": "1.0.0",
  "private": true,
  "description": "CodeMirror 6 bundle (Java + Python) inlined into testready/index.html",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --target=es2020 --outfile=cm.min.js && python3 inline.py"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.1",
    "esbuild": "^0.28.2"
  }
}
