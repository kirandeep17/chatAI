# Copy to .env and fill in. Leave TTD_API_URL empty to run against sample-data.json.

# Full POST URL of the Trade Desk endpoint, e.g.
# https://api.thetradedesk.com/v3/thirdpartydata/query
TTD_API_URL=

# Sent as the TTD-Auth header
TTD_AUTH_TOKEN=

# JSON body for the POST. If it contains PageSize, the server pages through
# all results automatically (PageStartIndex is advanced for you).
TTD_REQUEST_BODY={"ProviderId":"polk3pd","PageStartIndex":0,"PageSize":1000}

# ProviderElementIds that should be treated as test data (comma-separated)
TEST_ELEMENT_IDS=C-10
# exact | prefix | contains   (prefix => C-10, C-101, C-10_ABC ... are all test)
TEST_MATCH_MODE=exact

TTD_TIMEOUT_MS=60000
PORT=3000
